# Public values embedded into the browser bundle. Do not put service-role or
# OpenAI keys here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Production: the HTTPS URL of the separately deployed backend, without a
# trailing slash. Local development falls back to http://localhost:3001.
VITE_API_BASE_URL=https://your-nutrica-api.vercel.app

# Used by Supabase password-reset emails. Normally this is the frontend URL.
VITE_FRONTEND_URL=https://your-frontend.vercel.app
